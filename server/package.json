{
  "name": "svc-api",
  "version": "1.10.5",
  "description": "SVC API",
  "main": "app.js",
  "private": true,
  "scripts": {
    "tsc": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only ./app/app.ts",
    "build": "rimraf dist && webpack && copyfiles -u 1 \"./app/data/*\" \"./dist\" && copyfiles -u 3 \"./node_modules/@tubular/geo-tz/data/geo.dat\" \"./dist\" && (chmod +x ./dist/app.js || echo \"\")",
    "start": "tsc && node -r dotenv/config dist/app.js",
    "lint": "eslint \"**/*.ts\""
  },
  "author": "Kerry Shetline <kerry@shetline.com>",
  "license": "MIT",
  "dependencies": {
    "@tubular/geo-tz": "^8.1.4",
    "@tubular/math": "^3.4.2",
    "@tubular/time": "^3.10.5",
    "@tubular/util": "^4.18.2",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "basic-auth": "^2.0.1",
    "by-request": "^1.4.1",
    "dotenv": "^17.2.2",
    "emitter": "^0.0.5",
    "express": "^5.1.0",
    "follow-redirects": "^1.15.11",
    "html-entities": "^2.6.0",
    "iconv-lite": "^0.7.0",
    "morgan": "^1.10.1",
    "mysql": "^2.18.1",
    "public-ip": "^5.0.0",
    "request-ip": "^3.3.0",
    "rotating-file-stream": "^3.2.7",
    "unidecode-plus": "^1.0.5"
  },
  "devDependencies": {
    "@types/basic-auth": "^1.1.8",
    "@types/express": "^5.0.3",
    "@types/follow-redirects": "^1.14.4",
    "@types/html-entities": "^1.3.4",
    "@types/iconv-lite": "0.0.1",
    "@types/morgan": "^1.9.10",
    "@types/mysql": "^2.15.27",
    "@types/node": "^24.2.0",
    "@types/request-ip": "^0.0.41",
    "@types/serve-index": "^1.9.4",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "copyfiles": "^2.4.1",
    "eslint": "^8.31.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "rimraf": "^6.0.1",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-license-plugin": "^4.5.1"
  }
}
